# Copia este archivo a .env. Nunca subas .env al repositorio.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://localhost:5432/silver_minds

# --- Supabase Auth -----------------------------------------------------------
# Recomendado: claves asimétricas mediante JWKS.
# SUPABASE_JWKS_URL=https://<ref>.supabase.co/auth/v1/.well-known/jwks.json
# Solo desarrollo local: secreto HS256 para firmar tokens con `python -m app.cli dev-token`.
SUPABASE_JWT_SECRET=cambia-este-secreto-local-de-al-menos-32-caracteres
SUPABASE_JWT_AUDIENCE=authenticated

# --- Supabase Storage (privado) ----------------------------------------------
STORAGE_PROVIDER=local
# STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=audio-temp

# --- OpenAI ------------------------------------------------------------------
# "fake" usa un proveedor simulado determinista, sin llamadas externas.
AI_PROVIDER=fake
# AI_PROVIDER=openai
# OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODERATION_MODEL=omni-moderation-latest
# gpt-4o-mini-transcribe está en retiro: OpenAI lo elimina el 26 de febrero de 2027.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# --- Correo ------------------------------------------------------------------
# "fake" escribe los correos en var/outbox en lugar de enviarlos.
EMAIL_PROVIDER=fake
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
EMAIL_FROM=Silver Minds <no-reply@example.com>

# Base de los enlaces incluidos en los correos.
PUBLIC_LINK_BASE_URL=http://localhost:8000/api/v1

DEFAULT_COUNTRY=CL
DAILY_MESSAGE_QUOTA=200
AUDIO_RETENTION_HOURS=12
